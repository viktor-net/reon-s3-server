<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль публикации для прод-подобной сборки API.
  Используется в Dockerfile через аргумент PUBLISH_PROFILE
  (см. README, раздел «API в контейнере»), а также локально:
    dotnet publish src/Reon.Api/Reon.Api.csproj -p:PublishProfile=Prod
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <PublishDir>bin/Release/net10.0/publish/</PublishDir>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
