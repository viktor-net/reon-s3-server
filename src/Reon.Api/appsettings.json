{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "S3": {
    "ServiceUrl": "http://localhost:8080",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1",
    "BucketName": "reon-files",
    "ForcePathStyle": true,
    "EnsureBucket": true
  },
  "FileStorage": {
    "DefaultOwner": "system",
    "MaxFileSizeBytes": 1073741824,
    "MultipartThresholdBytes": 67108864,
    "MultipartPartSizeBytes": 16777216,
    "MinMultipartPartSizeBytes": 5242880,
    "MaxMultipartParts": 10000,
    "MultipartUploadLifetimeDays": 7,
    "MultipartCleanupIntervalMinutes": 60,
    "KeyPrefix": "files/",
    "PendingTimeoutMinutes": 60,
    "DeletingRetryMinutes": 5,
    "ReconciliationIntervalMinutes": 5,
    "OrphanSweepEnabled": true,
    "OrphanSweepIntervalMinutes": 360,
    "OrphanGracePeriodHours": 24,
    "DeletedRetentionDays": 30,
    "MaxTags": 50,
    "MaxTagKeyLength": 64,
    "MaxTagValueLength": 256,
    "MaxDescriptionLength": 2000,
    "MaxOriginalNameLength": 512,
    "MaxContentTypeLength": 255
  },
  "Database": {
    "AutoMigrate": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/reon-.ndjson",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Admin": {
    "UsageCacheSeconds": 60,
    "MaxPageSize": 200,
    "MaxPresignedUrlLifetimeSeconds": 604800,
    "MaxSearchObjects": 5000,
    "DefaultActor": "system",
    "EventHeartbeatSeconds": 30
  }
}
