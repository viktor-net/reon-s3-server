# Скопируйте файл в .env и заполните значения. .env не коммитится.
# Значения по умолчанию — только для локального стенда. Для production
# смените пароли/креды и задайте S3_SERVICE_URL и API_PUBLIC_BASE_URL.

# Пароль Postgres. Должен совпадать с тем, что использует сервис postgres.
POSTGRES_PASSWORD=reon_dev_password

# Креды S3/Swift для контейнера API.
S3_ACCESS_KEY=test:tester
S3_SECRET_KEY=testing

# Адрес уже существующего S3 для docker-compose.prod.yml.
# Для локального стенда не нужен: API ходит в swift:8080 по compose-сети.
# S3_SERVICE_URL=http://10.20.0.15:8080

# Секрет HMAC для временных ссылок на скачивание через API.
# Обязателен для профиля api, минимум 32 символа.
# Для production сгенерируйте случайное значение.
DOWNLOAD_LINK_SECRET=dev-download-link-secret-change-me

# Публичный адрес API, на который подписываются временные ссылки.
# В production — внешний HTTPS-адрес API, например https://api.example.com.
# API_PUBLIC_BASE_URL=http://localhost:10007

# Необязательные переопределения.
# API_IMAGE=reon-s3-api:local
# API_PUBLISH_PROFILE=Prod
# API_ENVIRONMENT=Production
# API_PORT=10007
# POSTGRES_DB=reon
# POSTGRES_USER=reon
# S3_REGION=us-east-1
# S3_BUCKET_NAME=reon-files
# S3_FORCE_PATH_STYLE=true
# S3_ENSURE_BUCKET=true
# DATABASE_AUTO_MIGRATE=true
#
# Возможности внешнего S3 для docker-compose.prod.yml.
# Для Swift s3api оставьте значения по умолчанию.
# S3_CAPABILITY_VERSIONING=true
# S3_CAPABILITY_OBJECT_TAGS=false
# S3_CAPABILITY_LIFECYCLE=false
# S3_CAPABILITY_BUCKET_POLICY=false
# S3_CAPABILITY_OBJECT_LOCK=false
#
# Образ Swift S3. По умолчанию собирается локально из docker/swift/ при
# `docker compose up -d --build`. Укажите готовый образ, чтобы не собирать
# (например, из внутреннего registry): тогда запускайте без --build.
# SWIFT_IMAGE=swift-s3api-aio:2.33

# Чтобы не писать -f в каждой команде, можно задать список файлов.
# Разделитель зависит от ОС: ";" в Windows, ":" в Linux/macOS.
# COMPOSE_FILE=docker-compose.yml;docker-compose.api.yml
#
# Профиль api нужно включать явно — иначе поднимется только инфраструктура.
# COMPOSE_PROFILES=api
#
# Production-вариант: только API и Postgres, внешний S3, без коллектора.
# COMPOSE_FILE=docker-compose.prod.yml
