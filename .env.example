# Скопируйте файл в .env и заполните значения. .env не коммитится.
# Значения ниже — только для локального стенда, не для production.

# Пароль Postgres. Должен совпадать с тем, что использует сервис postgres.
POSTGRES_PASSWORD=reon_dev_password

# Креды S3/Swift для контейнера API.
S3_ACCESS_KEY=test:tester
S3_SECRET_KEY=testing

# Необязательные переопределения.
# API_IMAGE=reon-s3-api:local
# API_PUBLISH_PROFILE=Prod
# API_ENVIRONMENT=Production
# POSTGRES_DB=reon
# POSTGRES_USER=reon
# S3_REGION=us-east-1
# S3_BUCKET_NAME=reon-files
# DATABASE_AUTO_MIGRATE=true

# Чтобы не писать -f в каждой команде, можно задать список файлов.
# Разделитель зависит от ОС: ";" в Windows, ":" в Linux/macOS.
# COMPOSE_FILE=docker-compose.yml;docker-compose.api.yml
#
# Профиль api нужно включать явно — иначе поднимется только инфраструктура.
# COMPOSE_PROFILES=api
